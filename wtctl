    if [ -e "$boot_target" ] || [ -L "$boot_target" ]; then
        boot_found=1
        if [ -L "$boot_target" ]; then
            printf 'Boot integration: init script — unmanaged symlink (not inspected)\n'
        elif [ ! -f "$boot_target" ]; then
            printf 'Boot integration: init script — unmanaged non-regular path (not inspected)\n'
        elif [ ! -r "$boot_target" ]; then
            printf 'Boot integration: init script — unknown (not readable)\n'
        elif ! grep -q '^# Managed by wtctl$' "$boot_target"; then
            printf 'Boot integration: init script — unmanaged (left untouched)\n'
        elif grep -q '^USE_PROCD=1$' "$boot_target"; then
            # rc.common loads procd.sh and may lock even for "enabled". Never
            # execute the adapter: inspect its priorities and owned boot links.
            boot_start=$(get "$boot_target" START); boot_stop=$(get "$boot_target" STOP)
            boot_state='unknown (unrecognized boot priorities)'
            case "$boot_start:$boot_stop" in
                :*|*:|*[!0-9:]*) ;;
                *)
                    if [ -d /etc/rc.d ] && { [ ! -r /etc/rc.d ] || [ ! -x /etc/rc.d ]; }; then
                        boot_state='unknown (registration directory not accessible)'
                    elif ! command -v readlink >/dev/null 2>&1; then
                        boot_state='unknown (readlink unavailable)'
                    else
                        boot_real=$(readlink -f "$boot_target" 2>/dev/null) || boot_real=
                        boot_state=disabled
                        [ -n "$boot_real" ] || boot_state='unknown (cannot resolve startup path)'
                        if [ -n "$boot_real" ] && [ -L "/etc/rc.d/S${boot_start}wtctl" ] && [ -L "/etc/rc.d/K${boot_stop}wtctl" ] &&
                            [ "$(readlink -f "/etc/rc.d/S${boot_start}wtctl" 2>/dev/null)" = "$boot_real" ] &&
                            [ "$(readlink -f "/etc/rc.d/K${boot_stop}wtctl" 2>/dev/null)" = "$boot_real" ]; then boot_state=enabled; fi
                    fi;;
            esac
            printf 'Boot integration: openwrt — %s\n' "$boot_state"
        elif grep -q '^# Default-Start: 2 3 4 5$' "$boot_target"; then
            if command -v readlink >/dev/null 2>&1; then
                boot_real=$(readlink -f "$boot_target" 2>/dev/null) || boot_real=
