    if [ "$tx_binary_changed" = 1 ]; then
        if [ -f "$tx_binary_backup" ]; then mv "$tx_binary_backup" "$tx_binary"
        elif [ "$tx_binary_existed" = 0 ]; then rm -f "$tx_binary"; fi
    fi
    if [ -n "$tx_current" ]; then
        printf '%s\n' "$tx_current" > "$CONFIG/current.rollback.$$"; mv "$CONFIG/current.rollback.$$" "$CONFIG/current"
        if [ "$tx_daemon_running" = 1 ]; then
            (trap - EXIT INT TERM HUP; ensure_daemon; send_request sync) >/dev/null 2>&1 || printf 'wtctl: rollback restored configuration; check supervisor status.\n' >&2
        elif owned_alive "$STATE/daemon"; then (send_request shutdown) >/dev/null 2>&1 || :; fi
    else
        rm -f "$CONFIG/current"
        if owned_alive "$STATE/daemon"; then (send_request shutdown) >/dev/null 2>&1 || :; fi
    fi
    rm -f "$CONFIG/global.new.$$" "$CONFIG/server.new.$$" "$CONFIG/tunnel.new.$$"
