boot_report() {
    boot_found=0
    boot_target=/etc/init.d/wtctl
    if [ -e "$boot_target" ] || [ -L "$boot_target" ]; then
        boot_found=1
        if [ -L "$boot_target" ]; then
            printf 'Boot integration: init script — unmanaged symlink (not inspected)\n'
        elif [ ! -f "$boot_target" ]; then
            printf 'Boot integration: init script — unmanaged non-regular path (not inspected)\n'
        elif [ ! -r "$boot_target" ]; then
            printf 'Boot integration: init script — unknown (not readable)\n'
        elif ! grep -q '^# Managed by wtctl$' "$boot_target"; then
            printf 'Boot integration: init script — unmanaged (left untouched)\n'
        elif grep -q '^USE_PROCD=1$' "$boot_target"; then
            # rc.common loads procd.sh and may lock even for "enabled". Never
            # execute the adapter: inspect its priorities and owned boot links.
            boot_start=$(get "$boot_target" START); boot_stop=$(get "$boot_target" STOP)
            boot_state='unknown (unrecognized boot priorities)'
            case "$boot_start:$boot_stop" in
                :*|*:|*[!0-9:]*) ;;
                *)
                    if [ -d /etc/rc.d ] && { [ ! -r /etc/rc.d ] || [ ! -x /etc/rc.d ]; }; then
                        boot_state='unknown (registration directory not accessible)'
                    elif ! command -v readlink >/dev/null 2>&1; then
                        boot_state='unknown (readlink unavailable)'
                    else
                        boot_real=$(readlink -f "$boot_target" 2>/dev/null) || boot_real=
                        boot_state=disabled
                        [ -n "$boot_real" ] || boot_state='unknown (cannot resolve startup path)'
                        if [ -n "$boot_real" ] && [ -L "/etc/rc.d/S${boot_start}wtctl" ] && [ -L "/etc/rc.d/K${boot_stop}wtctl" ] &&
                            [ "$(readlink -f "/etc/rc.d/S${boot_start}wtctl" 2>/dev/null)" = "$boot_real" ] &&
                            [ "$(readlink -f "/etc/rc.d/K${boot_stop}wtctl" 2>/dev/null)" = "$boot_real" ]; then boot_state=enabled; fi
                    fi;;
            esac
            printf 'Boot integration: openwrt — %s\n' "$boot_state"
        elif grep -q '^# Default-Start: 2 3 4 5$' "$boot_target"; then
            if command -v readlink >/dev/null 2>&1; then
                boot_real=$(readlink -f "$boot_target" 2>/dev/null) || boot_real=
                boot_registered=0; boot_accessible=1
                set +f
                for boot_directory in /etc/rc[12345S].d /etc/rc.d/rc[12345S].d; do
                    [ -d "$boot_directory" ] || continue
                    if [ ! -r "$boot_directory" ] || [ ! -x "$boot_directory" ]; then boot_accessible=0; continue; fi
                    for boot_link in "$boot_directory"/S*wtctl; do
                        [ -L "$boot_link" ] || continue
                        [ -z "$boot_real" ] || [ "$(readlink -f "$boot_link" 2>/dev/null)" != "$boot_real" ] || boot_registered=1
                    done
                done
                set -f
                if [ -z "$boot_real" ]; then
                    printf 'Boot integration: sysv — unknown (cannot resolve startup path)\n'
                elif [ "$boot_registered" = 1 ]; then
                    printf 'Boot integration: sysv — registered (start links found)\n'
                elif [ "$boot_accessible" = 0 ]; then
                    printf 'Boot integration: sysv — unknown (registration directory not accessible)\n'
                else
                    printf 'Boot integration: sysv — not registered (manual boot hooks may exist)\n'
                fi
            else
                printf 'Boot integration: sysv — unknown (readlink unavailable)\n'
            fi
        else
            printf 'Boot integration: init script — unknown (unrecognized managed adapter)\n'
        fi
    fi
    boot_target=/etc/systemd/system/wtctl.service
    if [ -e "$boot_target" ] || [ -L "$boot_target" ]; then
        boot_found=1
        if [ -L "$boot_target" ]; then
            printf 'Boot integration: systemd — unmanaged symlink (not inspected)\n'
        elif [ ! -f "$boot_target" ]; then
            printf 'Boot integration: systemd — unmanaged non-regular path (not inspected)\n'
        elif [ ! -r "$boot_target" ]; then
            printf 'Boot integration: systemd — unknown (not readable)\n'
        elif ! grep -q '^# Managed by wtctl$' "$boot_target"; then
            printf 'Boot integration: systemd — unmanaged (left untouched)\n'
        elif command -v systemctl >/dev/null 2>&1; then
            boot_state=$(systemctl is-enabled wtctl.service 2>/dev/null) || :
            case "$boot_state" in
                enabled|enabled-runtime|disabled|masked|masked-runtime|static|indirect|alias|linked|linked-runtime|generated|transient) ;;
                *) boot_state='unknown (systemctl query failed)';;
            esac
            printf 'Boot integration: systemd — %s\n' "$boot_state"
        else
            printf 'Boot integration: systemd — unknown (systemctl unavailable)\n'
        fi
    fi
    [ "$boot_found" != 0 ] || printf 'Boot integration: not installed\n'
    printf 'Boot registration is separate from current supervisor state; use wtctl status.\n'
}
doctor() {
    printf 'wtctl %s; Linux architecture: %s\n' "$VERSION" "$(uname -m)"
    distro=linux; [ ! -f /etc/openwrt_release ] || distro=openwrt
    printf 'Platform: %s (architecture alone does not guarantee ABI compatibility)\n' "$distro"
