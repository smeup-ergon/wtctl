            cmp -s "$retained/server" "$active/__previous_control/server"; then
            mv "$STATE/tunnels/__control" "$STATE/tunnels/__previous_control" || return 1
        fi
    fi
    set +f
    for workdir in "$STATE"/tunnels/*; do
        [ -d "$workdir" ] || continue
        name=${workdir##*/}
        if [ ! -d "$active/$name" ]; then stop_one "$name"; rm -rf "$workdir"; fi
    done
    for tunnel_dir in "$active"/*; do
        [ -d "$tunnel_dir" ] || continue
        name=${tunnel_dir##*/}; work=$STATE/tunnels/$name
        [ -d "$work" ] || private_dir "$work"
        old=$(head -n 1 "$work/snapshot" 2>/dev/null)
        old_binary=$(head -n 1 "$work/binary" 2>/dev/null)
        if owned_alive "$work/worker" && [ "$old_binary" = "$executable" ] && cmp -s "$old/tunnel" "$tunnel_dir/tunnel" && cmp -s "$old/server" "$tunnel_dir/server"; then continue; fi
        stop_one "$name"
        printf '%s\n' "$tunnel_dir" > "$work/snapshot"
        printf '%s\n' "$executable" > "$work/binary"
        rm -f "$work/status"
        "$SELF" _worker "$name" "$tunnel_dir" "$executable" </dev/null >/dev/null 2>&1 &
        worker_pid=$!; record_pid "$work/worker" "$worker_pid"
        worker_wait=0
        while [ ! -f "$work/status" ] && owned_alive "$work/worker" && [ "$worker_wait" -lt 5 ]; do
