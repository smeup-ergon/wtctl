                [ ! -e "$target" ] || fail 'Startup file already exists'
                printf '# Managed by wtctl\n[Unit]\nDescription=wstunnel manager\nAfter=network.target\n[Service]\nExecStart=/usr/sbin/wtctl daemon\nRestart=always\nRestartSec=5\nTimeoutStopSec=30\nKillMode=control-group\n[Install]\nWantedBy=multi-user.target\n' > "$target"
                register_startup "$adapter" "$target"
            else
                grep -q '^# Managed by wtctl$' "$target" || fail 'Not a managed startup file'
                systemctl disable --now wtctl; rm -f "$target"; systemctl daemon-reload
            fi;;
        sysv)
            target=/etc/init.d/wtctl
            if [ "$action" = install ]; then
                [ -d /etc/init.d ] || fail '/etc/init.d is required for a SysV hook'
                [ ! -e "$target" ] || fail 'Startup file already exists'
                printf '#!/bin/sh\n# Managed by wtctl\n### BEGIN INIT INFO\n# Provides: wtctl\n# Required-Start: $network\n# Required-Stop: $network\n# Default-Start: 2 3 4 5\n# Default-Stop: 0 1 6\n### END INIT INFO\ncase "$1" in start) /usr/sbin/wtctl daemon --background;; stop) /usr/sbin/wtctl shutdown;; restart) /usr/sbin/wtctl shutdown; /usr/sbin/wtctl daemon --background;; *) exit 1;; esac\n' > "$target"
                chmod 755 "$target"
                register_startup "$adapter" "$target"
            else
                grep -q '^# Managed by wtctl$' "$target" || fail 'Not a managed startup file'
                "$SELF" shutdown; command -v update-rc.d >/dev/null 2>&1 && update-rc.d -f wtctl remove
                rm -f "$target"
            fi;;
        *) fail 'Choose openwrt, systemd or sysv';;
    esac
}
# First installation: an accepted configuration with no tunnels and control
# disabled, so the service runs idle until the first apply. The installed
# manager's source URL is accepted; an unchanged url= downloads nothing.
bootstrap() {
    url https "$1" || fail 'Invalid manager URL'
    lock config; trap 'unlock' EXIT
    accepted_wstunnel=
    # Reinstallation after uninstall without --purge keeps the accepted setup.
    if [ -f "$CONFIG/accepted-current" ] && [ -f "$CONFIG/activation-state" ]; then
        accepted_wstunnel=$(get "$CONFIG/activation-state" wstunnel_url)
        cp "$CONFIG/accepted-current" "$CONFIG/current" || exit 1
    else
        publish_config || exit 1
        cp "$CONFIG/current" "$CONFIG/accepted-current" || exit 1
    fi
    { put manager_url "$1"; put wstunnel_url "$accepted_wstunnel"; } > "$CONFIG/activation-state.new.$$"
    mv "$CONFIG/activation-state.new.$$" "$CONFIG/activation-state" || exit 1
    unlock; trap - EXIT
}
uninstall_startup() {
    for target in /etc/init.d/wtctl /etc/systemd/system/wtctl.service; do
        [ -e "$target" ] || [ -L "$target" ] || continue
        if [ -L "$target" ] || [ ! -f "$target" ] || ! grep -q '^# Managed by wtctl$' "$target"; then
            printf 'Left unmanaged startup file untouched: %s\n' "$target"; continue
        fi
        if [ "$target" = /etc/systemd/system/wtctl.service ]; then adapter=systemd
        elif grep -q '^USE_PROCD=1$' "$target"; then adapter=openwrt
        else adapter=sysv; fi
        startup remove "$adapter" --yes
        printf 'Removed %s boot integration.\n' "$adapter"
    done
}
validate_manager() {
    [ -s "$1" ] && grep -q '^# wtctl: root-operated, POSIX-shell wstunnel client manager for Linux.$' "$1" &&
        sh -n "$1" && [ "$(bounded 15 "$1" --version)" != '' ]
}
activation_status() {
    event "activation $1"
    printf '%s\n' "$1" > "$STATE/activation.new.$$"
    mv "$STATE/activation.new.$$" "$STATE/activation"
}
job_result() {
    printf '%s\n' "$2" > "$1/result.new.$$"
    mv "$1/result.new.$$" "$1/result"
}
# A dropbear forced command receives one bounded header and, for PUT, exact bytes.
# Shell read consumes a socket byte-wise, so it never takes body bytes; the
# capped form avoids several processes per header byte on slow devices.
# shellcheck disable=SC3045 # feature-probed below; POSIX fallback otherwise
read_header_capped() { IFS= read -r -n 129 header; }
read_header_bytes() {
    header=; count=0
    while :; do
        byte=$(dd bs=1 count=1 2>/dev/null | hex)
        [ -n "$byte" ] || return 1
        [ "$byte" != 0a ] || return 0
        case "$byte" in 0[0-9a-f]|1[0-9a-f]|7f) return 1;; esac
        header=$header$(printf '%b' "\\$(printf '%03o' "$((0x$byte))")")
        count=$((count+1)); [ "$count" -le 128 ] || return 1
    done
}
read_control_request() {
    request_dir=$1
    if (printf 'abc\n' | { read_header_capped && [ "$header" = abc ]; }) 2>/dev/null; then
        read_header_capped || return 1
    else read_header_bytes || return 1; fi
    [ "${#header}" -le 128 ] || return 1
    case "$header" in *[![:print:]]*) return 1;; esac
    printf '%s\n' "$header" > "$request_dir/header"
    case "$header" in
        GET|'GET ACTIVE'|STATUS) return 0;;
        PUT\ *) length=${header#PUT }; number "$length" && [ "$length" -gt 0 ] && [ "$length" -le 65536 ] || return 1
            dd bs=1 count="$length" of="$request_dir/input" 2>/dev/null || return 1
            [ "$(wc -c < "$request_dir/input")" -eq "$length" ];;
        *) return 1;;
    esac
}
# The receiver account: root-equivalent, blank password, accepted only by
# receivers (-B). Only an entry carrying RECEIVER_GECOS is ever changed.
RECEIVER_USER=wtctl
RECEIVER_GECOS='wtctl control receiver'
receiver_available() { command -v dropbear >/dev/null 2>&1 && command -v dropbearkey >/dev/null 2>&1; }
receiver_shell() {
    shell=$(awk '/^\//{print; exit}' /etc/shells 2>/dev/null)
    printf '%s\n' "${shell:-/bin/sh}"
}
account_owned() { awk -F: -v u="$RECEIVER_USER" -v g="$RECEIVER_GECOS" '$1==u && $5==g {found=1} END {exit !found}' /etc/passwd; }
account_foreign() { awk -F: -v u="$RECEIVER_USER" -v g="$RECEIVER_GECOS" '$1==u && $5!=g {found=1} END {exit !found}' /etc/passwd; }
account_add() {
    ! account_foreign || return 1
    account_owned && return 0
    cp -p /etc/passwd /etc/passwd.wtctl.$$ || return 1
    printf '%s::0:0:%s:/:%s\n' "$RECEIVER_USER" "$RECEIVER_GECOS" "$(receiver_shell)" >> /etc/passwd.wtctl.$$ &&
        mv /etc/passwd.wtctl.$$ /etc/passwd || { rm -f /etc/passwd.wtctl.$$; return 1; }
    event "receiver account added"
}
account_remove() {
    account_owned || return 0
    cp -p /etc/passwd /etc/passwd.wtctl.$$ || return 1
    awk -F: -v u="$RECEIVER_USER" -v g="$RECEIVER_GECOS" '!($1==u && $5==g)' /etc/passwd > /etc/passwd.wtctl.$$ &&
        mv /etc/passwd.wtctl.$$ /etc/passwd || { rm -f /etc/passwd.wtctl.$$; return 1; }
    event "receiver account removed"
}
# Account presence follows accepted control. Call under the config lock.
account_sync() {
    if [ "$(get "$CONFIG/control" enabled 2>/dev/null)" = true ]; then account_add; else account_remove; fi
}
host_key() {
    [ -s "$CONFIG/control_host_key" ] && return 0
    rm -f "$CONFIG/control_host_key.new.$$"
    dropbearkey -t ed25519 -f "$CONFIG/control_host_key.new.$$" >/dev/null 2>&1 &&
        mv "$CONFIG/control_host_key.new.$$" "$CONFIG/control_host_key"
}
control_receiver() {
    port "$1" || fail 'Invalid receiver port'
    receiver_available || fail 'dropbear and dropbearkey are required for control'
    host_key || fail 'Cannot create control host key'
    export WTCTL_RECEIVER_PORT="$1" WTCTL_HANDLER_SELF="$SELF"
    # -e passes this environment to the forced command; paths stay literal data.
    # -E with stderr discarded keeps per-connection logs out of syslog.
    exec dropbear -F -E -e -B -j -k -T 1 -I 300 -r "$CONFIG/control_host_key" -P "$STATE/receiver-$1.pid" \
        -c 'exec "$WTCTL_HANDLER_SELF" _handle' -p "127.0.0.1:$1" 2>/dev/null
}
control_handle() (
    handle_started=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)
    request_dir=$(mktemp -d "$STATE/request.XXXXXXXX") || exit 1
    trap 'event "handler done port=${WTCTL_RECEIVER_PORT:-} request=${header:-invalid} started=$handle_started"; rm -rf "$request_dir"' EXIT
    if ! bounded 15 "$SELF" _read-control "$request_dir"; then printf 'KO invalid-request\n'; exit 1; fi
    header=$(cat "$request_dir/header")
    header=${header%% *}
    event "handler parsed port=${WTCTL_RECEIVER_PORT:-} request=$header started=$handle_started"
    header=$(cat "$request_dir/header")
    case "$header" in
        GET|'GET ACTIVE')
            source=$CONFIG/desired.ini; [ "$header" != 'GET ACTIVE' ] || source=$CONFIG/active.ini
            if [ ! -f "$source" ]; then printf 'KO unavailable\n'; exit 1; fi
            cp "$source" "$request_dir/reply" || exit 1
            printf 'OK %s\n' "$(wc -c < "$request_dir/reply")"; cat "$request_dir/reply";;
        STATUS)
            status_text=$(cat "$STATE/activation" 2>/dev/null || printf idle)
            printf '%s\n' "$status_text" > "$request_dir/reply"
            printf 'OK %s\n' "$(wc -c < "$request_dir/reply")"; cat "$request_dir/reply";;
        PUT\ *) submit_ini "$request_dir/input" "${WTCTL_RECEIVER_PORT:-}";;
    esac
)
apply_ini() (
    [ "$#" = 1 ] || fail 'Usage: wtctl apply FILE|-'
    input_dir=$(mktemp -d "$STATE/input.XXXXXXXX") || exit 1
    trap 'rm -rf "$input_dir"' EXIT
    if [ "$1" = - ]; then
        dd bs=1 count=65537 of="$input_dir/input" 2>/dev/null || exit 1
    else [ -f "$1" ] && [ ! -L "$1" ] && cp "$1" "$input_dir/input" || fail 'Configuration must be a regular file'; fi
    submit_ini "$input_dir/input" ''
)
submit_ini() (
    submission=$(mktemp -d "$STATE/submission.XXXXXXXX") || exit 1
    trap 'rm -rf "$submission"' EXIT
    if ! compile_ini "$1" "$submission" >"$submission/error" 2>&1; then printf 'KO invalid-configuration\n'; cat "$submission/error" >&2; exit 1; fi
    lock submission
    trap 'unlock; rm -rf "$submission"' EXIT
    pending=$(cat "$STATE/pending" 2>/dev/null || :)
    if [ -n "$pending" ] && [ "$(cat "$STATE/latest-job" 2>/dev/null)" = "$pending" ] && cmp -s "$1" "$pending/input"; then
        job=$pending; confirmation=0
        if [ -n "$2" ] && [ "$2" = "$(cat "$pending/receiver" 2>/dev/null)" ]; then
            : > "$pending/confirmed"; confirmation=1
        fi
    else
        job=$(mktemp -d "$STATE/job.XXXXXXXX") || exit 1
        cp "$1" "$job/input" && cp "$SELF" "$job/runner" && chmod 700 "$job/runner" || exit 1
        cp "$1" "$CONFIG/desired.ini.new.$$" && mv "$CONFIG/desired.ini.new.$$" "$CONFIG/desired.ini" || exit 1
        printf '%s\n' "$job" > "$STATE/latest-job.new.$$" && mv "$STATE/latest-job.new.$$" "$STATE/latest-job" || exit 1
        # Run from an immutable copy, independent of nc, the supervisor and SELF.
        (trap '' HUP; exec "$job/runner" _activate "$job" "$SELF" </dev/null >"$job/log" 2>&1) &
        coordinator_pid=$!; record_pid "$job/coordinator" "$coordinator_pid"
        confirmation=0
    fi
    unlock; trap 'rm -rf "$submission"' EXIT
    while :; do
        if [ -f "$job/result" ]; then
            result=$(cat "$job/result"); printf '%s\n' "$result"
            : > "$job/delivered"
            case "$result" in OK*) exit 0;; *) exit 1;; esac
        fi
        if [ "$confirmation" = 0 ] && [ "$(cat "$STATE/pending" 2>/dev/null)" = "$job" ]; then
            printf 'PENDING confirmation-required\n'; exit 0
        fi
        if ! owned_alive "$job/coordinator"; then
            # Result publication and process exit may race this observation.
            [ ! -f "$job/result" ] || continue
            printf 'KO activation-process-lost\n'; exit 1
        fi
        sleep 1
    done
)
# The coordinator owns rollback until all activation checks have succeeded.
# Only its private runner survives replacement of the installed executable.
activate_rollback() {
    trap - EXIT HUP INT TERM
    event "rollback begin job=${job##*/} failure=${failure:-} changed=${activation_changed:-0}"
    if [ "${activation_changed:-0}" = 1 ]; then
        if owned_alive "$STATE/daemon"; then (send_request pause) || :; fi
        for record in global control; do
            if [ -f "$job/old/$record" ]; then cp "$job/old/$record" "$CONFIG/$record"; else rm -f "$CONFIG/$record"; fi
        done
        for record in servers tunnels; do
            rm -rf "${CONFIG:?}/${record:?}"; cp -R "$job/old/$record" "$CONFIG/$record"
        done
        account_sync || :
        for software in manager binary; do
            destination=$(cat "$job/$software-path" 2>/dev/null || :)
            [ -n "$destination" ] || continue
            if [ -f "$job/$software-old" ]; then cp "$job/$software-old" "$destination.rollback.$$" && mv "$destination.rollback.$$" "$destination"
            else rm -f "$destination"; fi
        done
        if [ -n "$old_current" ]; then printf '%s\n' "$old_current" > "$CONFIG/current.new.$$"; mv "$CONFIG/current.new.$$" "$CONFIG/current"
        else rm -f "$CONFIG/current"; fi
        if [ -z "$old_current" ]; then
            if owned_alive "$STATE/daemon"; then (send_request shutdown) || :; fi
        else
            if owned_alive "$STATE/daemon"; then (send_request reexec) || :; fi
            (SELF=$installed; ensure_daemon; send_request sync) || :
        fi
    fi
    terminate "$job/candidate-worker"; terminate "$job/candidate-child"; terminate "$job/candidate-receiver"
    if [ "$(cat "$STATE/pending" 2>/dev/null)" = "$job" ]; then rm -f "$STATE/pending"; fi
    rm -f "$STATE/previous-control"
    activation_status "failed ${failure:-activation-failed}"
    job_result "$job" "KO ${failure:-activation-failed}"
    unlock
}
activate_ini() {
    job=$1; installed=$2
    # Wait outside the normal bounded mutation lock: downloads and confirmation
    # can take longer than ten seconds. Never steal a live coordinator's lock.
    LOCK=$STATE/config.lock
    while ! mkdir "$LOCK" 2>/dev/null; do
        if [ -f "$LOCK/owner" ] && ! owned_alive "$LOCK/owner"; then rm -f "$LOCK/owner"; rmdir "$LOCK" 2>/dev/null || :; fi
        sleep 1
    done
    record_pid "$LOCK/owner" "$$"
    if [ "$(cat "$STATE/latest-job")" != "$job" ]; then job_result "$job" 'KO superseded'; unlock; return 1; fi
    activation_changed=0; old_current=$(current); failure=activation-failed
    trap 'activate_rollback' EXIT
    trap 'exit 130' HUP INT TERM
    mkdir "$job/compiled" "$job/old" || exit 1
    compile_ini "$job/input" "$job/compiled" || exit 1
    for record in global control servers tunnels; do [ ! -e "$CONFIG/$record" ] || cp -R "$CONFIG/$record" "$job/old/$record" || exit 1; done
    activation_status applying
    # Bootstrap deliberately has no tunnels and control disabled. It is the
    # accepted fallback if the first desired configuration cannot activate.
    if [ -z "$old_current" ]; then publish_config || exit 1; old_current=$(current); fi
    if [ ! -f "$CONFIG/accepted-current" ]; then cp "$CONFIG/current" "$CONFIG/accepted-current" || exit 1; fi
    compiled=$job/compiled
    confirmation_required=0
    if [ "$(get "$compiled/control" enabled)" = true ]; then
        if [ ! -f "$CONFIG/active.ini" ] || [ ! -f "$CONFIG/control" ] || [ "$(get "$CONFIG/control" enabled)" != true ] ||
            [ "$(get "$compiled/manager" url)" != "$(get "$CONFIG/activation-state" manager_url)" ] ||
            [ "$(get "$compiled/global" url)" != "$(get "$CONFIG/activation-state" wstunnel_url)" ]; then confirmation_required=1
        else
            for key in server bind listen; do [ "$(get "$compiled/control" "$key")" = "$(get "$CONFIG/control" "$key")" ] || confirmation_required=1; done
            cmp -s "$compiled/servers/$(get "$compiled/control" server)" "$CONFIG/servers/$(get "$CONFIG/control" server)" || confirmation_required=1
        fi
    fi
    if [ "$(get "$compiled/control" enabled)" = true ]; then
        failure=control-unavailable
        receiver_available && ! account_foreign && (host_key) || exit 1
    fi
    binary_destination=$(binary_path "$compiled/global")
    if [ "$(get "$compiled/global" url)" != "$(get "$CONFIG/activation-state" wstunnel_url)" ] || ! validate_binary "$binary_destination"; then
        failure=download-failed
        (download "$compiled/global" "$job/binary-new") || exit 1
    fi
    if [ "$(get "$compiled/manager" url)" != "$(get "$CONFIG/activation-state" manager_url)" ]; then
        { put format 2; put storage persistent; put url "$(get "$compiled/manager" url)"; put max_kib "$(get "$compiled/global" max_kib)"; put reserve_kib "$(get "$compiled/global" reserve_kib)"; } > "$job/manager-global"
        failure=manager-download-failed
        (download "$job/manager-global" "$job/manager-new" manager) || exit 1
    fi
    [ "$(cat "$STATE/latest-job")" = "$job" ] || { failure=superseded; exit 1; }
    failure=activation-failed
    if { [ -f "$job/binary-new" ] || [ -f "$job/manager-new" ]; } && owned_alive "$STATE/daemon"; then
        (send_request pause) || exit 1
    fi
    activation_changed=1
    for software in binary manager; do
        [ -f "$job/$software-new" ] || continue
        destination=$binary_destination; [ "$software" != manager ] || destination=$installed
        if [ "$software" = binary ]; then private_dir "$(dirname "$destination")"; else safe_path "$destination"; fi
        printf '%s\n' "$destination" > "$job/$software-path"
        [ ! -f "$destination" ] || cp -p "$destination" "$job/$software-old" || exit 1
        cp "$job/$software-new" "$destination.new.$$" && chmod 700 "$destination.new.$$" && mv "$destination.new.$$" "$destination" || exit 1
    done
    for record in global servers tunnels; do
        rm -rf "${CONFIG:?}/${record:?}"; cp -R "$compiled/$record" "$CONFIG/$record" || exit 1
    done
    cp "$compiled/control" "$CONFIG/control" || exit 1
    receiver_port=8099
    [ ! -f "$job/old/control" ] || receiver_port=$(get "$job/old/control" receiver)
    [ -n "$receiver_port" ] || receiver_port=8099
    if [ "$confirmation_required" = 1 ]; then
        if [ "$receiver_port" = 8099 ]; then receiver_port=8100; else receiver_port=8099; fi
        if [ -d "$old_current/__control" ] &&
            { [ "$(get "$old_current/__control/tunnel" listen)" != "$(get "$compiled/control" listen)" ] ||
              [ "$(get "$old_current/__control/server" endpoint)" != "$(get "$compiled/servers/$(get "$compiled/control" server)" endpoint)" ]; }; then
            printf '%s\n' "$old_current/__control" > "$STATE/previous-control"
        fi
    fi
    put receiver "$receiver_port" >> "$CONFIG/control"
    if [ "$(get "$compiled/control" enabled)" = true ]; then
        failure=control-unavailable; account_add || exit 1; failure=activation-failed
    fi
    disabling_control=0
    if [ "$(get "$compiled/control" enabled)" = false ] && [ -f "$job/old/control" ] && [ "$(get "$job/old/control" enabled)" = true ]; then
        # Preserve the management path until the submitting handler has written
        # the successful response. Other activation checks run first.
        disabling_control=1
        cp "$CONFIG/control" "$job/disabled-control"
        cp "$job/old/control" "$CONFIG/control"
    fi
    publish_config || exit 1
    # Only manager replacement needs a supervisor restart. Keeping the receiver
    # alive lets ordinary PUTs (especially disabling control) receive a reply.
    if [ -f "$job/manager-new" ] && owned_alive "$STATE/daemon"; then (send_request reexec) || exit 1; fi
    (SELF=$installed; ensure_daemon; send_request sync) || exit 1
    if [ "$confirmation_required" = 1 ]; then
        printf '%s\n' "$receiver_port" > "$job/receiver"
        printf '%s\n' "$job" > "$STATE/pending.new.$$"; mv "$STATE/pending.new.$$" "$STATE/pending"
        activation_status awaiting-confirmation
        deadline=$(($(date +%s)+60)); failure='confirmation-timeout'
        while [ ! -f "$job/confirmed" ]; do
            [ "$(cat "$STATE/latest-job")" = "$job" ] || { failure=superseded; exit 1; }
            [ "$(date +%s)" -lt "$deadline" ] || exit 1
            sleep 1
        done
    fi
    # Serialize the final acceptance with submissions and candidate confirmation.
    saved_lock=$LOCK; lock submission
    if [ "$(cat "$STATE/latest-job")" != "$job" ]; then unlock; LOCK=$saved_lock; failure=superseded; exit 1; fi
    cp "$job/input" "$CONFIG/active.ini.new.$$" && mv "$CONFIG/active.ini.new.$$" "$CONFIG/active.ini" || exit 1
    { put manager_url "$(get "$compiled/manager" url)"; put wstunnel_url "$(get "$compiled/global" url)"; } > "$CONFIG/activation-state.new.$$"
    mv "$CONFIG/activation-state.new.$$" "$CONFIG/activation-state" || exit 1
    rm -f "$STATE/pending"
    if [ -f "$STATE/previous-control" ]; then
        rm -f "$STATE/previous-control"
        publish_config || exit 1
        (send_request sync) || exit 1
    fi
    activation_status idle
    job_result "$job" 'OK 0'
    if [ "$disabling_control" = 1 ]; then
        delivered_deadline=$(($(date +%s)+5))
        while [ ! -f "$job/delivered" ] && [ "$(date +%s)" -lt "$delivered_deadline" ]; do sleep 1; done
        cp "$job/disabled-control" "$CONFIG/control"
        publish_config
        (send_request sync) || :
        account_remove || :
    fi
    cp "$CONFIG/current" "$CONFIG/accepted-current.new.$$" && mv "$CONFIG/accepted-current.new.$$" "$CONFIG/accepted-current" || exit 1
    unlock; LOCK=$saved_lock; unlock
    trap - EXIT HUP INT TERM
}
help() {
    printf '%s\n' "wtctl $VERSION — wstunnel client manager" \
        '  status                 supervisor, tunnel and control state' \
        '  doctor                 platform, dependency and boot checks' \
        '  validate FILE          check a complete INI configuration offline' \
        '  apply FILE|-           activate a complete INI configuration (- reads stdin)' \
        '  daemon [--background] | shutdown   (service plumbing)' \
        '  uninstall [--purge] --yes          (also removes boot integration;' \
        '                                      --purge deletes the configuration)' \
        "Configuration: $CONFIG/wtctl.ini (sample written by scripts/install.sh)."
}
# Record-based setups predate INI management and have no migration path.
legacy() { [ -f "$CONFIG/current" ] && [ ! -f "$CONFIG/activation-state" ] && [ ! -f "$CONFIG/desired.ini" ]; }
command=${1:-}; [ "$#" = 0 ] || shift
case "$command" in ''|--help|-h|help) help; exit;; --version) printf '%s\n' "$VERSION"; exit;; doctor) doctor; exit $?;; validate) validate_ini "$@"; exit $?;; esac
# The handler already prepared state; its reader only fills a private directory.
if [ "$command" = _read-control ]; then read_control_request "$@"; exit $?; fi
prepare
case "$command" in
    shutdown|uninstall) ;;
    *) ! legacy || fail 'Legacy record-based configuration is not supported: run wtctl uninstall --purge --yes, then reinstall';;
esac
case "$command" in
    status) status;;
    apply) apply_ini "$@";;
    _receiver) control_receiver "$@";;
    _handle) control_handle;;
    _activate) activate_ini "$@";;
    _bootstrap) [ "$#" = 1 ] || fail 'Usage: _bootstrap MANAGER_URL'; bootstrap "$1";;
    shutdown) if owned_alive "$STATE/daemon"; then send_request shutdown; fi; count=0; while owned_alive "$STATE/daemon" && [ "$count" -lt 30 ]; do sleep 1; count=$((count+1)); done; owned_alive "$STATE/daemon" && fail 'Shutdown did not finish'; exit 0;;
    daemon) case "$*" in '') validate_config || exit 1; daemon;; --background) ensure_daemon;; *) fail 'Usage: daemon [--background]';; esac;;
    _worker) worker "$@";; _download) download "$@";;
    _ready)
        count=0
        while ! owned_alive "$STATE/daemon"; do
            count=$((count+1)); [ "$count" -lt 15 ] || fail 'Service did not start the supervisor'; sleep 1
        done
        send_request sync;;
    _check-startup) [ "$#" = 1 ] || fail 'Missing startup adapter'; check_startup "$1";;
    _startup) [ "$#" = 3 ] || fail 'Usage: _startup install|enable|remove ADAPTER --yes'; case "$1" in install|enable|remove) startup "$@";; *) fail 'Unknown startup action';; esac;;
    uninstall)
        purge=0; case "$*" in --yes) ;; '--purge --yes'|'--yes --purge') purge=1;; *) fail 'Usage: uninstall [--purge] --yes';; esac
        uninstall_startup
        "$SELF" shutdown || exit 1
        account_remove || fail 'Cannot remove the wtctl receiver account'
        rm -rf "$STATE"; [ "$purge" = 0 ] || rm -rf "$CONFIG"
        [ "$SELF" != /usr/sbin/wtctl ] || rm -f "$SELF"
        printf 'Uninstalled; configuration preserved unless --purge was requested.\n';;
    *) fail 'Unknown command; use --help';;
esac
