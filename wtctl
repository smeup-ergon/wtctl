tunnel_details() (
    # Read only tunnel settings; never include server credentials.
    file=$1
    bind=$(get "$file" bind); target=$(get "$file" target)
    case "$bind" in *:*) bind="[$bind]";; esac
    case "$target" in \[*\]) ;; *:*) target="[$target]";; esac
    printf 'server=%s %s/%s listen=%s:%s target=%s:%s' \
        "$(get "$file" server)" "$(get "$file" direction)" "$(get "$file" protocol)" \
        "$bind" "$(get "$file" listen)" "$target" "$(get "$file" port)"
