    mv "$STATE/request.new.$$" "$STATE/requests/$rid"
    count=0
    while [ ! -f "$STATE/responses/$rid" ]; do
        if ! owned_alive "$STATE/daemon"; then
            # An init system may already have sent TERM. Its supervisor cannot
            # consume new requests while cleaning up; observed exit is enough
            # for idempotent shutdown. Do not leave a request for the next daemon.
            if [ "$1" = shutdown ]; then
                rm -f "$STATE/requests/$rid" "$STATE/responses/$rid"
                return 0
            fi
            [ -f "$STATE/responses/$rid" ] || fail 'Supervisor stopped before acknowledging request'
            break
        fi
        count=$((count+1)); [ "$count" -lt 90 ] || fail 'Request timed out; check status'
        sleep 1
    done
    response=$(head -n 1 "$STATE/responses/$rid"); rm -f "$STATE/responses/$rid"
    [ "$response" = ok ] || fail "$response"
    if [ "$1" = shutdown ]; then
        count=0
        while owned_alive "$STATE/daemon"; do
            count=$((count+1)); [ "$count" -lt 30 ] || fail 'Supervisor shutdown timed out'
            sleep 1
        done
    fi
