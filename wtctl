)
reconcile() {
    if [ -d "$active/__previous_control" ] && [ -d "$STATE/tunnels/__control" ] &&
        [ ! -d "$STATE/tunnels/__previous_control" ]; then
        retained=$(head -n 1 "$STATE/tunnels/__control/snapshot" 2>/dev/null)
