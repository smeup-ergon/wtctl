transaction_begin() {
    tx_file=$1; tx_backup=$CONFIG/rollback.$$
    tx_current=$(current); tx_binary=; tx_binary_backup=; tx_binary_changed=0; tx_binary_existed=0
    tx_daemon_running=0; owned_alive "$STATE/daemon" && tx_daemon_running=1
