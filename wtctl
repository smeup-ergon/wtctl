            receiver_port=$(get "$active/__control/tunnel" port)
            if ! owned_alive "$STATE/receiver" || [ "$(get "$STATE/receiver" port)" != "$receiver_port" ]; then
                if [ -d "$active/__previous_control" ] && owned_alive "$STATE/receiver" &&
                    [ "$(get "$STATE/receiver" port)" = "$(get "$active/__previous_control/tunnel" port)" ]; then
