status() {
    daemon_state=stopped; owned_alive "$STATE/daemon" && daemon_state=running
    printf 'Supervisor: %s\nBinary: %s\n' "$daemon_state" "$(head -n 1 "$STATE/binary-status" 2>/dev/null || printf unconfigured)"
    printf 'Download retry epoch: %s\n' "$(head -n 1 "$STATE/next-download" 2>/dev/null || printf 0)"
    printf '%-20s %-12s %-8s %-6s %-8s %-10s %s\n' TUNNEL STATE PID EXIT RESTARTS NEXT_RETRY DETAILS
    active=$(current)
    [ -d "$active" ] || active=$CONFIG/no-active-snapshot
    set +f
    for tunnel_dir in "$active"/*; do
        [ -d "$tunnel_dir" ] || continue
        name=${tunnel_dir##*/}; work=$STATE/tunnels/$name
        [ "$name" != __previous_control ] || continue
        if [ "$name" = __control ]; then
            printf 'Control: %s (%s)\n' "$(get "$work/status" state)" "$(tunnel_details "$tunnel_dir/tunnel")"
            continue
        fi
        state=$(get "$work/status" state); [ -n "$state" ] || state=stopped
        pid=$(get "$work/status" pid)
        if [ "$state" = running ] && ! owned_alive "$work/child"; then state=stopped; pid=; fi
        printf '%-20s %-12s %-8s %-6s %-8s %-10s %s\n' "$name" "$state" "$pid" "$(get "$work/status" exit)" "$(get "$work/status" restarts)" "$(get "$work/status" next_retry)" "$(tunnel_details "$tunnel_dir/tunnel")"
