                receiver_pid=$!; record_pid "$STATE/receiver" "$receiver_pid"
                put port "$receiver_port" >> "$STATE/receiver"
                event "receiver start port=$receiver_port pid=$receiver_pid"
            fi
        elif [ -f "$STATE/receiver" ]; then event "receiver stop port=$(get "$STATE/receiver" port)"; terminate "$STATE/receiver"; rm -f "$STATE/receiver"; fi
        if [ -d "$active/__previous_control" ]; then
            previous_port=$(get "$active/__previous_control/tunnel" port)
            if ! owned_alive "$STATE/previous-receiver"; then
                "$SELF" _receiver "$previous_port" </dev/null >/dev/null 2>&1 &
                previous_pid=$!; record_pid "$STATE/previous-receiver" "$previous_pid"
                put port "$previous_port" >> "$STATE/previous-receiver"
                event "previous-receiver start port=$previous_port pid=$previous_pid"
            fi
        elif [ -f "$STATE/previous-receiver" ]; then event "previous-receiver stop"; terminate "$STATE/previous-receiver"; rm -f "$STATE/previous-receiver"; fi
        now=$(date +%s)
        if [ "$now" -lt "$scan_due" ]; then sleep 1; continue; fi
        scan_due=$((now+5))
        executable=$(binary_path "$active/global")
