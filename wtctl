#!/bin/sh
# wtctl: root-operated, POSIX-shell wstunnel client manager for Linux.
# Configuration is data: never source it, never eval it.
# shellcheck disable=SC2012,SC2015,SC2016,SC2030,SC2031
# ls is used only for numeric directory ownership; &&/|| guards are intentional.
set -f
umask 077
VERSION=0.3.0
CONFIG=${WTCTL_CONFIG_DIR:-/etc/wtctl}
STATE=${WTCTL_STATE_DIR:-/tmp/wtctl}
SELF=$(CDPATH='' cd -- "$(dirname -- "$0")" && printf '%s/%s' "$(pwd)" "$(basename -- "$0")")

fail() { printf 'wtctl: %s\n' "$*" >&2; exit 1; }
# Bounded diagnostic trail of lifecycle transitions; the supervisor rotates it.
event() {
    [ -d "$STATE" ] || return 0
    printf '%s %s %s %s\n' "$(date +%s)" "$(cut -d' ' -f1 /proc/uptime 2>/dev/null)" "$$" "$*" >> "$STATE/events" 2>/dev/null || :
}
rotate_events() {
    [ "$(wc -c < "$STATE/events" 2>/dev/null || printf 0)" -le 262144 ] || mv -f "$STATE/events" "$STATE/events.1" 2>/dev/null || :
}
valid_id() { case "$1" in ''|all|global|*[!A-Za-z0-9_-]*) return 1;; esac; [ ${#1} -le 64 ]; }
single_line() { [ "$(printf '%s' "$1" | tr -d '\r\n')" = "$1" ]; }
get() { awk -v key="$2" 'index($0,key "=")==1 {print substr($0,length(key)+2); exit}' "$1" 2>/dev/null; }
put() { single_line "$2" || fail 'Values must not contain newlines'; printf '%s=%s\n' "$1" "$2"; }
number() { case "$1" in ''|*[!0-9]*|0[0-9]*) return 1;; esac; [ ${#1} -le 12 ]; }
port() { number "$1" && [ ${#1} -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
host() { printf '%s\n' "$1" | grep -Eq '^([A-Za-z0-9][A-Za-z0-9.-]*|\[[0-9A-Fa-f:]+\])$'; }
bind_address() {
    case "$1" in
        *:*) printf '%s\n' "$1" | grep -Eq '^[0-9A-Fa-f:]+$';;
        *) printf '%s\n' "$1" | awk -F. 'NF!=4 {exit 1} {for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || length($i)>3 || $i>255) exit 1}';;
    esac
}
url() {
    single_line "$2" || return 1
    printf '%s\n' "$2" | grep -Eq "^$1://(\[[0-9A-Fa-f:]+\]|[A-Za-z0-9][A-Za-z0-9.-]*)(:[0-9]{1,5})?(/[A-Za-z0-9._~!\$&()*+,;=:@%/?-]*)?$" || return 1
    authority=${2#*://}; authority=${authority%%/*}
    case "$authority" in \[*\]) return 0;; *:*) port "${authority##*:}";; esac
}
absolute() { case "$1" in /*) ;; *) return 1;; esac; single_line "$1" && case "$1" in *'/../'*|*'/..'|*'/./'*|*'/.'|'/') return 1;; esac; }
# Reject symlink components, including a pre-created /tmp/wtctl trap.
safe_path() {
    absolute "$1" || fail 'Use a non-root absolute path without dot components'
    rest=${1#/}; checked=
    while [ -n "$rest" ]; do
        component=${rest%%/*}; checked=$checked/$component
        [ ! -L "$checked" ] || fail "Symlink path component: $checked"
        case "$rest" in */*) rest=${rest#*/};; *) rest=;; esac
    done
}
private_dir() {
    safe_path "$1"
    if [ -e "$1" ]; then
        [ -d "$1" ] || fail "Not a directory: $1"
        [ "$(ls -nd "$1" | awk '{print $3}')" = 0 ] || fail "Directory is not root-owned: $1"
    else mkdir -p "$1" || fail "Cannot create $1"; fi
    chmod 700 "$1" || fail "Cannot protect $1"
}
prepare() {
    [ "$(id -u)" = 0 ] || fail 'Run as root'
    [ -d /proc/self ] || fail 'Linux /proc must be mounted'
    case "$CONFIG/" in "$STATE/"*) fail 'Configuration must not be inside runtime state';; esac
    case "$STATE/" in "$CONFIG/"*) fail 'Runtime state must not be inside configuration';; esac
    private_dir "$CONFIG"; private_dir "$STATE"
    for dir in "$CONFIG/servers" "$CONFIG/tunnels" "$STATE/requests" "$STATE/responses" "$STATE/tunnels" "$CONFIG/applied"; do private_dir "$dir"; done
    if [ ! -f "$CONFIG/global" ]; then
        { put format 2; put storage ram; put url ''; put max_kib 24576; put reserve_kib 1024; } > "$CONFIG/global.new.$$"
        mv "$CONFIG/global.new.$$" "$CONFIG/global" || fail 'Cannot initialize configuration'
    fi
}
# Linux process start time prevents stale PID files from killing reused PIDs.
token() { [ -r "/proc/$1/stat" ] && awk '{sub(/^.*\) /, ""); print $20}' "/proc/$1/stat"; }
alive() {
    number "$1" && [ -n "$2" ] && [ "$(token "$1")" = "$2" ] && kill -0 "$1" 2>/dev/null || return 1
    [ "$(awk '{sub(/^.*\) /, ""); print $1}' "/proc/$1/stat" 2>/dev/null)" != Z ]
}
owned_alive() { alive "$(get "$1" pid)" "$(get "$1" token)"; }
record_pid() { { put pid "$2"; put token "$(token "$2")"; } > "$1.new.$$"; mv "$1.new.$$" "$1"; }
terminate() {
    tp=$(get "$1" pid); tt=$(get "$1" token)
    alive "$tp" "$tt" || return 0
    kill -TERM "$tp" 2>/dev/null || :
    tries=0
    while alive "$tp" "$tt" && [ "$tries" -lt 5 ]; do sleep 1; tries=$((tries+1)); done
    alive "$tp" "$tt" && kill -KILL "$tp" 2>/dev/null
    return 0
}
lock() {
    LOCK=$STATE/$1.lock
    attempts=0
    while ! mkdir "$LOCK" 2>/dev/null; do
        if [ -f "$LOCK/owner" ] && ! owned_alive "$LOCK/owner"; then
            rm -f "$LOCK/owner"; rmdir "$LOCK" 2>/dev/null || :
        fi
        attempts=$((attempts+1)); [ "$attempts" -lt 10 ] || fail "Busy: $1"
        sleep 1
    done
    record_pid "$LOCK/owner" "$$"
}
unlock() { rm -f "$LOCK/owner"; rmdir "$LOCK" 2>/dev/null || :; }
fields() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    awk -v allowed="$2" 'BEGIN {n=split(allowed,a," "); for(i=1;i<=n;i++) ok[a[i]]=1} {p=index($0,"="); k=substr($0,1,p-1); if(!p || !ok[k] || seen[k]++ || index($0,"\r")) exit 1} END {for(k in ok) if(!seen[k]) exit 1}' "$1"
}
validate_global() {
    fields "$1" 'format storage url max_kib reserve_kib' || return 1
    [ "$(get "$1" format)" = 2 ] || return 1
    storage=$(get "$1" storage); source_url=$(get "$1" url)
    case "$storage" in ram|persistent) ;; *) return 1;; esac
    [ -z "$source_url" ] || url https "$source_url" || return 1
    max_kib=$(get "$1" max_kib); reserve_kib=$(get "$1" reserve_kib)
    number "$max_kib" && [ "$max_kib" -ge 1024 ] && [ "$max_kib" -le 262144 ] &&
        number "$reserve_kib" && [ "$reserve_kib" -ge 1024 ] && [ "$reserve_kib" -le 262144 ]
}
validate_server() {
    fields "$1" 'endpoint auth prefix username password ca' || return 1
    endpoint=$(get "$1" endpoint); auth=$(get "$1" auth); prefix=$(get "$1" prefix)
    username=$(get "$1" username); password=$(get "$1" password); ca=$(get "$1" ca)
    url wss "$endpoint" || return 1
    case "$auth" in
        none) ;;
        path) printf '%s\n' "$prefix" | grep -Eq '^[A-Za-z0-9._~-]+$' || return 1;;
        basic) [ -n "$username" ] || return 1; case "$username" in *:*) return 1;; esac;;
        *) return 1;;
    esac
    [ -z "$ca" ] || { absolute "$ca" && [ -f "$ca" ] && [ -r "$ca" ]; }
}
validate_tunnel() {
    fields "$1" 'server direction protocol bind listen target port' || return 1
    server=$(get "$1" server); direction=$(get "$1" direction); protocol=$(get "$1" protocol)
    bind=$(get "$1" bind); listen=$(get "$1" listen); target=$(get "$1" target); target_port=$(get "$1" port)
    valid_id "$server" || return 1
    case "$direction" in forward|reverse) ;; *) return 1;; esac
    case "$protocol" in tcp|udp) ;; *) return 1;; esac
    bind_address "$bind" && port "$listen" && host "$target" && port "$target_port"
}
validate_config() (
    config_root=${1:-$CONFIG}
    validate_global "$config_root/global" || fail 'Invalid global configuration'
    set +f
    for file in "$config_root"/servers/*; do
        [ -e "$file" ] || continue
        valid_id "${file##*/}" && validate_server "$file" || fail "Invalid server: ${file##*/}"
    done
    for file in "$config_root"/tunnels/*; do
        [ -e "$file" ] || continue
        valid_id "${file##*/}" && validate_tunnel "$file" || fail "Invalid tunnel: ${file##*/}"
        [ -f "$config_root/servers/$server" ] || fail "Unknown server for ${file##*/}"
        # Reverse listeners conflict only on the same profile.
        for other in "$config_root"/tunnels/*; do
            [ "$file" != "$other" ] || continue
            [ "$direction" = "$(get "$other" direction)" ] && [ "$protocol" = "$(get "$other" protocol)" ] && [ "$listen" = "$(get "$other" listen)" ] || continue
            [ "$direction" != reverse ] || [ "$server" = "$(get "$other" server)" ] || continue
            ob=$(get "$other" bind)
            if [ "$bind" = "$ob" ] || [ "$bind" = 0.0.0.0 ] || [ "$ob" = 0.0.0.0 ] || [ "$bind" = :: ] || [ "$ob" = :: ]; then
                fail "Conflicting configured listeners: ${file##*/} and ${other##*/}"
            fi
        done
    done
)
# Compile a complete INI document into private records for the existing validators.
# The caller owns the empty output directory; this never touches live settings.
compile_ini() (
    input=$1; output=$2
    [ -f "$input" ] && [ ! -L "$input" ] || fail 'Configuration must be a regular file'
    bytes=$(wc -c < "$input")
    [ "$bytes" -le 65536 ] || fail 'Configuration exceeds 64 KiB'
    printable=$(LC_ALL=C tr -cd '\11\12\40-\176' < "$input" | wc -c)
    [ "$bytes" -eq "$printable" ] || fail 'Configuration must contain printable ASCII, tabs and newlines only'
    mkdir "$output/servers" "$output/tunnels" || exit 1
    LC_ALL=C awk -v out="$output" '
    function error(message) {print "wtctl: INI line " NR ": " message > "/dev/stderr"; bad=1; exit 1}
    function trim(s) {sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s}
    function field(k, fallback) {return ((section SUBSEP k) in values) ? values[section,k] : fallback}
    function required(k) {if(field(k, "")=="") error("missing " section "." k); return field(k, "")}
    function writefield(path,k,v) {print k "=" v > path}
    function record(   p,k,keys,n,i) {
        if(section=="") return
        if(section=="wtctl") {
            if(required("format")!="1") error("unsupported format")
            p=out "/global"
            writefield(p,"format","2"); writefield(p,"storage",field("storage","ram"))
            writefield(p,"url",required("wstunnel_url"))
            writefield(p,"max_kib",field("max_kib","24576"))
            writefield(p,"reserve_kib",field("reserve_kib","1024"))
            writefield(out "/manager","url",required("url"))
        } else if(section=="control") {
            p=out "/control"
            writefield(p,"enabled",field("enabled","true"))
            writefield(p,"server",required("server"))
            writefield(p,"bind",field("bind","::"))
            writefield(p,"listen",field("listen","8099"))
        } else if(kind=="server") {
            p=out "/servers/" name
            writefield(p,"endpoint",required("endpoint")); writefield(p,"auth",field("auth","none"))
            n=split("prefix username password ca",keys," ")
            for(i=1;i<=n;i++) writefield(p,keys[i],field(keys[i],""))
        } else {
            p=out "/tunnels/" name
            writefield(p,"server",required("server")); writefield(p,"direction",field("direction","forward"))
            writefield(p,"protocol",field("protocol","tcp")); writefield(p,"bind",field("bind","127.0.0.1"))
            writefield(p,"listen",required("listen")); writefield(p,"target",required("target"))
            writefield(p,"port",required("port"))
        }
        close(p)
    }
    {
        if($0 ~ /[^\t -~]/) error("only printable ASCII and tabs are supported")
        line=trim($0)
        if(line=="" || line ~ /^[#;]/) next
        if(line ~ /^\[/) {
            record()
            if(line !~ /^\[[^][]+\]$/) error("invalid section")
            section=substr(line,2,length(line)-2); kind=""; name=""
            if(sections[section]++) error("duplicate section")
            if(section=="wtctl") allowed=" format url wstunnel_url storage max_kib reserve_kib "
            else if(section=="control") allowed=" enabled server bind listen "
            else {
                n=split(section,parts," ")
                kind=parts[1]; name=parts[2]
                if(n!=2 || (kind!="server" && kind!="tunnel") || name !~ /^[A-Za-z0-9_-]+$/ || length(name)>64 || name=="all" || name=="global" || name=="__control" || name=="__previous_control") error("invalid section name")
                if(kind=="server") allowed=" endpoint auth prefix username password ca "
                else allowed=" server direction protocol bind listen target port "
            }
            next
        }
        if(section=="") error("field before section")
        pos=index(line,"="); if(!pos) error("expected key=value")
        key=trim(substr(line,1,pos-1)); value=trim(substr(line,pos+1))
        if(key !~ /^[a-z_]+$/ || index(allowed," " key " ")==0) error("unknown field")
        if((section SUBSEP key) in values) error("duplicate field")
        if(index(value,"REPLACE-ME")) error("replace the sample placeholder value")
        values[section,key]=value
    }
    END {
        if(bad) exit 1
        record()
        if(!sections["wtctl"] || !sections["control"]) error("wtctl and control sections are required")
    }' "$input" || exit 1
    validate_config "$output" || exit 1
    url https "$(get "$output/manager" url)" || fail 'Invalid wtctl URL'
    url https "$(get "$output/global" url)" || fail 'Invalid wstunnel URL'
    control_server=$(get "$output/control" server)
    valid_id "$control_server" && [ -f "$output/servers/$control_server" ] || fail 'Unknown control server'
    case "$(get "$output/control" enabled)" in true|false) ;; *) fail 'Invalid control enabled value';; esac
    bind_address "$(get "$output/control" bind)" && port "$(get "$output/control" listen)" || fail 'Invalid control listener'
    # Reserve the receiver name and validate the control listener against ordinary
    # reverse listeners without ever publishing it as an ordinary tunnel.
    if [ "$(get "$output/control" enabled)" = true ]; then
        { put server "$control_server"; put direction reverse; put protocol tcp
          put bind "$(get "$output/control" bind)"; put listen "$(get "$output/control" listen)"
          put target localhost; put port 8099; } > "$output/tunnels/__control"
        validate_config "$output" || exit 1
        rm "$output/tunnels/__control"
    fi
)
validate_ini() (
    [ "$#" = 1 ] || fail 'Usage: wtctl validate FILE'
    staging=$(mktemp -d "${TMPDIR:-/tmp}/wtctl-validate.XXXXXXXX") || exit 1
    trap 'rm -rf "$staging"' EXIT
    trap 'exit 1' HUP INT TERM
    compile_ini "$1" "$staging" || exit 1
    printf 'Configuration valid\n'
)
publish_config() {
    validate_config || exit 1
    base=$(date +%s)-$$; suffix=0
    generation=$CONFIG/applied/$base-$suffix
    while [ -e "$generation" ]; do suffix=$((suffix+1)); generation=$CONFIG/applied/$base-$suffix; done
    mkdir "$generation" || fail 'Cannot create applied configuration'
    cp "$CONFIG/global" "$generation/global" || fail 'Cannot snapshot configuration'
    set +f
    for file in "$CONFIG"/tunnels/*; do
        [ -e "$file" ] || continue
        name=${file##*/}; mkdir "$generation/$name" || fail 'Cannot create tunnel snapshot'
        cp "$file" "$generation/$name/tunnel" || fail 'Cannot snapshot tunnel'
        cp "$CONFIG/servers/$(get "$file" server)" "$generation/$name/server" || fail 'Cannot snapshot server'
    done
    set -f
    if [ -f "$CONFIG/control" ] && [ "$(get "$CONFIG/control" enabled)" = true ]; then
        mkdir "$generation/__control" || fail 'Cannot snapshot control'
        { put server "$(get "$CONFIG/control" server)"; put direction reverse; put protocol tcp
          put bind "$(get "$CONFIG/control" bind)"; put listen "$(get "$CONFIG/control" listen)"
          put target 127.0.0.1; put port "$(get "$CONFIG/control" receiver)"; } > "$generation/__control/tunnel"
        cp "$CONFIG/servers/$(get "$CONFIG/control" server)" "$generation/__control/server" || exit 1
    fi
    if [ -f "$STATE/previous-control" ]; then
        previous_control=$(cat "$STATE/previous-control")
        [ ! -d "$previous_control" ] || cp -R "$previous_control" "$generation/__previous_control" || exit 1
    fi
    printf '%s\n' "$generation" > "$CONFIG/current.new.$$" && mv "$CONFIG/current.new.$$" "$CONFIG/current" || fail 'Cannot publish applied configuration'
}
current() { head -n 1 "$CONFIG/current" 2>/dev/null; }
phase() { printf '%s\n' "$1" > "$STATE/binary-status.new.$$"; mv "$STATE/binary-status.new.$$" "$STATE/binary-status"; }
binary_path() {
    if [ "$(get "$1" storage)" = persistent ]; then printf '%s\n' "$CONFIG/bin/wstunnel"
    else printf '%s\n' "$STATE/bin/wstunnel"; fi
}
# Bounded execution without requiring the timeout applet.
# Stop the parent before walking children so a timed-out request cannot leave
# an orphan dd holding the socket open or spawn another reader during cleanup.
kill_tree() (
    tree_pid=$1; tree_token=$(token "$1")
    alive "$tree_pid" "$tree_token" || exit 0
    kill -STOP "$tree_pid" 2>/dev/null || exit 0
    tree_children=$(cat "/proc/$tree_pid/task/$tree_pid/children" 2>/dev/null || :)
    for tree_child in $tree_children; do kill_tree "$tree_child"; done
    alive "$tree_pid" "$tree_token" && kill -KILL "$tree_pid" 2>/dev/null
    exit 0
)
# A watchdog enforces the limit so a fast command returns at once rather than
# at the next one-second poll; every control request passes through here.
bounded() (
    limit=$1; shift
    exec 3<&0
    marker=$(mktemp "${TMPDIR:-/tmp}/wtctl-bounded.XXXXXXXX") || exit 1
    "$@" <&3 3<&- & bounded_pid=$!
    exec 3<&-
    bounded_token=$(token "$bounded_pid")
    (
        sleep "$limit" & timer=$!
        trap 'kill "$timer" 2>/dev/null; exit 0' TERM
        wait "$timer"
        alive "$bounded_pid" "$bounded_token" || exit 0
        printf expired > "$marker"; kill_tree "$bounded_pid"
    ) </dev/null >/dev/null 2>&1 &
    watchdog=$!
    trap 'kill "$watchdog" 2>/dev/null; kill_tree "$bounded_pid"; wait "$bounded_pid" 2>/dev/null; rm -f "$marker"; exit 143' TERM INT
    wait "$bounded_pid"; bounded_result=$?
    kill "$watchdog" 2>/dev/null; wait "$watchdog" 2>/dev/null
    expired=$(cat "$marker" 2>/dev/null); rm -f "$marker"
    [ "$expired" != expired ] || exit 124
    exit "$bounded_result"
)
hex() {
    if command -v od >/dev/null 2>&1; then od -An -tx1 | tr -d ' \n'
    elif command -v hexdump >/dev/null 2>&1; then hexdump -v -e '1/1 "%02x"'
    else return 1; fi
}
elf() {
    [ "$(dd if="$1" bs=1 count=4 2>/dev/null | hex)" = 7f454c46 ] || return 1
    { dd if="$1" bs=1 skip=4 count=2 2>/dev/null; dd if="$1" bs=1 skip=18 count=2 2>/dev/null; } | hex
}
validate_binary() (
    [ -f "$1" ] && [ -x "$1" ] || exit 1
    identity=$(elf "$1") || exit 1
    # /proc/PID/exe can identify an emulator under cross-architecture Docker.
    native=$(elf /bin/sh) || exit 1
    [ "$identity" = "$native" ] || exit 1
    help=$(bounded 15 "$1" client --help 2>/dev/null) || exit 1
    for option in --local-to-remote --remote-to-local --tls-verify-certificate --http-upgrade-credentials --http-upgrade-path-prefix --nb-worker-threads --reverse-tunnel-connection-retry-max-backoff; do
        printf '%s\n' "$help" | grep -q -- "$option" || exit 1
    done
)
# Download helper is a child so supervisor shutdown can interrupt WAN waits.
download() {
    dg=$1; db=${2:-$(binary_path "$dg")}; du=$(get "$dg" url)
    url https "$du" || { phase 'missing-or-invalid-url'; return 1; }
    command -v curl >/dev/null 2>&1 || { phase 'curl-required-for-verified-https'; return 1; }
    private_dir "$(dirname "$db")"
    dm=$(get "$dg" max_kib); dr=$(get "$dg" reserve_kib)
    free=$(df -Pk "$(dirname "$db")" | awk 'END {print $4}')
    number "$free" && [ "$free" -ge "$((dm+dr))" ] || { phase 'insufficient-space'; return 1; }
    rm -f "$db.part"; phase downloading
    # POSIX ulimit -f uses 512-byte blocks. curl independently bounds bytes/time.
    (ulimit -f "$((dm*2))" || exit 1
        exec curl --fail --silent --location --proto '=https' --proto-redir '=https' \
            --connect-timeout 20 --max-time 180 --max-filesize "$((dm*1024))" --output "$db.part" "$du"
    ) >/dev/null 2>&1 & downloader=$!
    record_pid "$STATE/download-child" "$downloader"
    trap 'terminate "$STATE/download-child"; rm -f "$db.part" "$STATE/download-child"; exit 143' TERM INT
    wait "$downloader"; result=$?
    rm -f "$STATE/download-child"
    trap - TERM INT
    if [ "$result" != 0 ]; then rm -f "$db.part"; phase download-failed; return 1; fi
    size=$(wc -c < "$db.part")
    if [ ! -s "$db.part" ] || [ "$size" -gt "$((dm*1024))" ]; then rm -f "$db.part"; phase empty-or-oversized-binary; return 1; fi
    chmod 700 "$db.part"
    if [ "${3:-wstunnel}" = manager ]; then
        validate_manager "$db.part" || { rm -f "$db.part"; phase incompatible-manager; return 1; }
    else validate_binary "$db.part" || { rm -f "$db.part"; phase incompatible-binary; return 1; }; fi
    mv "$db.part" "$db" || { rm -f "$db.part"; phase activation-failed; return 1; }
    phase ready
}
worker_status() {
    { put state "$1"; put pid "${child:-}"; put exit "${last_exit:-}"; put restarts "$restarts"; put next_retry "${next_retry:-0}"; } > "$work/status.new.$$"
    mv "$work/status.new.$$" "$work/status"
}
worker_cleanup() {
    trap '' TERM INT
    terminate "$work/child"; [ -z "${child:-}" ] || wait "$child" 2>/dev/null
    child=; next_retry=0; worker_status stopped
    rm -f "$work/child"
    exit 0
}
worker() {
    name=$1; snapshot=$2; executable=$3; work=$STATE/tunnels/$name
    # Keep metadata relative to the directory inode: control promotion may
    # rename this runtime slot without restarting its live connection.
    cd "$work" || exit 1
    work=.
    restarts=0; last_exit=; child=; next_retry=0; delay=2
    trap 'worker_cleanup' TERM INT
    validate_tunnel "$snapshot/tunnel" && validate_server "$snapshot/server" || fail 'Invalid applied tunnel'
    case "$bind" in *:*) bind="[$bind]";; esac
    case "$direction" in forward) flag=-L;; reverse) flag=-R;; esac
    uri=$protocol://$bind:$listen:$target:$target_port
    while :; do
        set -- "$executable" client --tls-verify-certificate --nb-worker-threads 1 --reverse-tunnel-connection-retry-max-backoff 30s "$flag" "$uri"
        case "$auth" in path) set -- "$@" --http-upgrade-path-prefix "$prefix";; basic) set -- "$@" --http-upgrade-credentials "$username:$password";; esac
        set -- "$@" "$endpoint"
        launched=$(date +%s)
        if [ -n "$ca" ]; then SSL_CERT_FILE=$ca RUST_LOG=off "$@" </dev/null >/dev/null 2>&1 &
        else RUST_LOG=off "$@" </dev/null >/dev/null 2>&1 & fi
        child=$!; record_pid "$work/child" "$child"; next_retry=0; worker_status running
        event "worker $name child-start pid=$child"
        wait "$child"; last_exit=$?
        event "worker $name child-exit status=$last_exit"
        rm -f "$work/child"; child=; restarts=$((restarts+1))
        now=$(date +%s); [ "$((now-launched))" -lt 60 ] || delay=2
        next_retry=$((now+delay)); worker_status backoff
        while [ "$(date +%s)" -lt "$next_retry" ]; do sleep 1; done
        delay=$((delay*2)); [ "$delay" -le 30 ] || delay=30
    done
}
stop_one() {
    work=$STATE/tunnels/$1
    [ -d "$work" ] || return 0
    terminate "$work/worker"
    # Also clean a child orphaned by a crashed worker.
    terminate "$work/child"
    rm -f "$work/worker" "$work/child" "$work/snapshot"
    if [ -f "$work/status" ]; then
        { put state stopped; put pid ''; put exit "$(get "$work/status" exit)"; put restarts "$(get "$work/status" restarts)"; put next_retry 0; } > "$work/status.new.$$"
