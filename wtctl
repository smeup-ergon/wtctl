    for utility in awk grep tr id ls chmod mkdir rm mv cp dirname basename date sleep head cmp dd wc df uname cut; do
        if ! command -v "$utility" >/dev/null 2>&1; then printf 'Missing: %s\n' "$utility"; missing=1; fi
    done
    if ! command -v od >/dev/null 2>&1 && ! command -v hexdump >/dev/null 2>&1; then
        printf 'Missing: od or hexdump (ELF compatibility checks)\n'; missing=1
    fi
    if command -v curl >/dev/null 2>&1; then printf 'HTTPS downloader: curl (CA trust must also be provisioned)\n'
    else
        printf 'Optional download capability missing: curl and CA trust. Local binaries still work.\n'
        [ "$distro" != openwrt ] || printf 'Administrator suggestion: opkg install curl ca-bundle\n'
    fi
    control_required=0
    [ "$(get "$CONFIG/control" enabled)" != true ] || control_required=1
    if receiver_available; then
        printf 'Control receiver: dropbear %s\n' "$(dropbear -V 2>&1 | awk '{print $2; exit}')"
    elif [ "$control_required" = 1 ]; then
        printf 'Missing: dropbear and dropbearkey (required by enabled control)\n'; missing=1
    else
        printf 'Control receiver unavailable: dropbear missing (needed only when control is enabled)\n'
    fi
    [ -d /proc/self ] || { printf 'Missing: mounted Linux /proc\n'; missing=1; }
    boot_report
    return "$missing"
}
register_startup() {
